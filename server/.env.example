# Require an x-api-key header on all endpoints (except /, /health, /docs, /openapi.json).
# Leave unset only for local dev: in production (Vercel, or NODE_ENV=production)
# a missing key makes every data endpoint return 503 instead of running open.
# SIJILAT_API_KEY=choose-a-long-random-secret

# Override the upstream base (rarely needed).
# SIJILAT_BASE_URL=https://api.sijilat.bh/api/

# Port for the Node server (ignored on Vercel).
# PORT=3000
