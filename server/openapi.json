{
  "openapi": "3.1.0",
  "info": {
    "title": "Sijilat API",
    "version": "0.2.0",
    "description": "Query the Kingdom of Bahrain's Sijilat commercial registry. Filters accept friendly names (case-insensitive), resolved to the registry's internal codes automatically. No registry account or key is required."
  },
  "servers": [
    {
      "url": "https://sijilat-api.vercel.app",
      "description": "Production"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness + registry reachability",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "registry": {
                      "type": "string"
                    },
                    "status_codes": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Registry unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Search commercial registrations",
        "description": "At least one filter is required. Name/sector/activity/status/type/nationality/municipality accept friendly names (case-insensitive, comma-separated for multiple) and resolve to codes. Default response is one page; use page/per_page to paginate or all=1 to pull everything.",
        "parameters": [
          {
            "name": "name_en",
            "in": "query",
            "description": "Company name in English (partial, case-insensitive)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "trading"
            }
          },
          {
            "name": "name_ar",
            "in": "query",
            "description": "Company name in Arabic (partial). Pair with lang=ar.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "تجارة"
            }
          },
          {
            "name": "cr",
            "in": "query",
            "description": "Exact Commercial Registration number",
            "required": false,
            "schema": {
              "type": "string",
              "example": "21"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by commercial-registration status. Accepts status name(s) or numeric code(s), case-insensitive, comma-separated for multiple (e.g. `ACTIVE,FROZEN`). You can also pass a lifecycle flag (`Active` or `Deleted`) to match every status in that group.\n\nAll 41 options, grouped by lifecycle flag:\n- **Active** (25): ACTIVE, ACTIVE WITHOUT LICENSE, DORMANT, FROZEN, FROZEN - NOT RENEWED, NOT RENEWED, NOT RENEWED WITHOUT LICENSE, Suspended by National Bureau for Revenue, Suspended by National Bureau for Revenue - UNDER SEQUESTER, UNDER LEGAL CUSTUDY, UNDER LEGAL CUSTUDY - NOT RENEWED, UNDER LIQUIDATION, UNDER LIQUIDATION – UNDER SEQUESTER, UNDER MORTGAGE, UNDER MORTGAGE - NOT RENEWED, UNDER MORTGAGE - NOT RENEWED - UNDER SEQUESTER, UNDER MORTGAGE - UNDER SEQUESTER, UNDER SEQUESTER, UNDER SEQUESTER - NOT RENEWED, UNDER SEQUESTER - NOT RENEWED WITHOUT LICENSE, UNDER SEQUESTER AND UNDER LEGAL CUSTODY, UNDER SEQUESTER WITHOUT LICENSE, Under Sequester and Under Legal Custody Not Renewed, VIOLATION - NOT RENEWED, VIOLATION - RENEWED\n- **Deleted** (16): BANKRUPT, BANKRUPT - UNDER SEQUESTER, DELETED - MERGED WITH ANOTHER BRANCH, DELETED BY RESOLUTION, DELETED BY RESOLUTION - UNDER SEQUESTER, DELETED WITH PAYMENT, DELETED WITH PAYMENT - SHELF COMPANY, DELETED WITH PAYMENT WITHOUT LICENSE, DELETED WITHOUT PAYMENT, Deactivated for Not Renewing the CR, Deactivated for Not Renewing the CR  - SHELF COMPANY, Deactivated for Not Renewing the CR - UNDER SEQUESTER, Deactivated for Not Renewing the CR WITHOUT LICENSE, LIQUIDATED, NEW REGISTRATION OR NEW BRANCH HAS BEEN REJECTED, SOLD OR LEGAL STATUS CHANGED",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ACTIVE",
                  "ACTIVE WITHOUT LICENSE",
                  "BANKRUPT",
                  "BANKRUPT - UNDER SEQUESTER",
                  "DELETED - MERGED WITH ANOTHER BRANCH",
                  "DELETED BY RESOLUTION",
                  "DELETED BY RESOLUTION - UNDER SEQUESTER",
                  "DELETED WITH PAYMENT",
                  "DELETED WITH PAYMENT - SHELF COMPANY",
                  "DELETED WITH PAYMENT WITHOUT LICENSE",
                  "DELETED WITHOUT PAYMENT",
                  "DORMANT",
                  "Deactivated for Not Renewing the CR",
                  "Deactivated for Not Renewing the CR  - SHELF COMPANY",
                  "Deactivated for Not Renewing the CR - UNDER SEQUESTER",
                  "Deactivated for Not Renewing the CR WITHOUT LICENSE",
                  "FROZEN",
                  "FROZEN - NOT RENEWED",
                  "LIQUIDATED",
                  "NEW REGISTRATION OR NEW BRANCH HAS BEEN REJECTED",
                  "NOT RENEWED",
                  "NOT RENEWED WITHOUT LICENSE",
                  "SOLD OR LEGAL STATUS CHANGED",
                  "Suspended by National Bureau for Revenue",
                  "Suspended by National Bureau for Revenue - UNDER SEQUESTER",
                  "UNDER LEGAL CUSTUDY",
                  "UNDER LEGAL CUSTUDY - NOT RENEWED",
                  "UNDER LIQUIDATION",
                  "UNDER LIQUIDATION – UNDER SEQUESTER",
                  "UNDER MORTGAGE",
                  "UNDER MORTGAGE - NOT RENEWED",
                  "UNDER MORTGAGE - NOT RENEWED - UNDER SEQUESTER",
                  "UNDER MORTGAGE - UNDER SEQUESTER",
                  "UNDER SEQUESTER",
                  "UNDER SEQUESTER - NOT RENEWED",
                  "UNDER SEQUESTER - NOT RENEWED WITHOUT LICENSE",
                  "UNDER SEQUESTER AND UNDER LEGAL CUSTODY",
                  "UNDER SEQUESTER WITHOUT LICENSE",
                  "Under Sequester and Under Legal Custody Not Renewed",
                  "VIOLATION - NOT RENEWED",
                  "VIOLATION - RENEWED"
                ]
              },
              "example": [
                "ACTIVE"
              ]
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "type",
            "in": "query",
            "description": "Company type name(s) or code(s)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "With Limited Liability Company"
            }
          },
          {
            "name": "nationality",
            "in": "query",
            "description": "Company nationality name(s)/flag (e.g. BAHRAINI, GCC) or code(s)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "BAHRAINI"
            }
          },
          {
            "name": "sector",
            "in": "query",
            "description": "Top-level business sector by name or code (see /lookups/sector)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "Manufacturing"
            }
          },
          {
            "name": "activity",
            "in": "query",
            "description": "Granular ISIC4 activity by name or code; names resolve via /lookups/activity (see that endpoint)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "restaurant"
            }
          },
          {
            "name": "municipality",
            "in": "query",
            "required": false,
            "description": "Filter by municipality. Accepts municipality name(s) or code(s), case-insensitive, comma-separated for multiple.\n\nAll 5 options:\n- Muharraq Municipality\n- Manama Municipality\n- Northern Area Municipality\n- Central Area Municipality\n- Southern Area Municipality",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Muharraq Municipality",
                  "Manama Municipality",
                  "Northern Area Municipality",
                  "Central Area Municipality",
                  "Southern Area Municipality"
                ]
              },
              "example": [
                "Manama Municipality"
              ]
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "partner",
            "in": "query",
            "description": "Partner/shareholder English name",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "partner_ar",
            "in": "query",
            "description": "Partner/shareholder Arabic name",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "partner_nat",
            "in": "query",
            "description": "Partner nationality name/code",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "partner_cr",
            "in": "query",
            "description": "Partner's CR number",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reg_from",
            "in": "query",
            "description": "Registered on or after (DD/MM/YYYY)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reg_to",
            "in": "query",
            "description": "Registered on or before (DD/MM/YYYY)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "road",
            "in": "query",
            "description": "Address: road number",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "flat",
            "in": "query",
            "description": "Address: flat number",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "block",
            "in": "query",
            "description": "Address: block number",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "building",
            "in": "query",
            "description": "Address: building number",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "passport",
            "in": "query",
            "description": "Partner passport number",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Results per page (default 25, max 200). Alias: limit.",
            "schema": {
              "type": "integer",
              "default": 25,
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "name": "all",
            "in": "query",
            "description": "Set to 1 to page through every match (bounded by max_scan_pages).",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "max_scan_pages",
            "in": "query",
            "description": "Max pages to fetch when all=1 (default 20).",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "fields",
            "in": "query",
            "description": "Comma-separated result fields to return (e.g. cr_number,name_en,status).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "description": "Set to 'ar' to match Arabic-culture names.",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "ar"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching companies",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "example": "live"
                    },
                    "total_matches": {
                      "type": "integer",
                      "example": 20778
                    },
                    "page": {
                      "type": "integer"
                    },
                    "per_page": {
                      "type": "integer"
                    },
                    "returned": {
                      "type": "integer"
                    },
                    "has_more": {
                      "type": "boolean"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "cr_number": {
                            "type": "string",
                            "example": "21"
                          },
                          "branch": {
                            "type": "string",
                            "example": "10"
                          },
                          "name_en": {
                            "type": "string",
                            "example": "INTERMART GENERAL TRADING W.L.L"
                          },
                          "name_ar": {
                            "type": "string"
                          },
                          "company_type": {
                            "type": "string",
                            "example": "With Limited Liability Company"
                          },
                          "status": {
                            "type": "string",
                            "example": "ACTIVE"
                          },
                          "registered_on": {
                            "type": "string",
                            "example": "05/09/2007"
                          },
                          "expires_on": {
                            "type": "string",
                            "example": "05/09/2027"
                          },
                          "activities": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "sector": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "No filter supplied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Upstream registry error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/company/{cr}": {
      "get": {
        "summary": "Full company profile",
        "description": "Returns capital, shareholders, board, signatories, address, activities, amendment history, and branches. Use raw=1 for the unmodified upstream payload.",
        "parameters": [
          {
            "name": "cr",
            "in": "path",
            "required": true,
            "description": "Commercial Registration number",
            "schema": {
              "type": "string",
              "example": "106966"
            }
          },
          {
            "name": "branch",
            "in": "query",
            "description": "Branch number (head office = 1)",
            "schema": {
              "type": "string",
              "default": "1"
            }
          },
          {
            "name": "raw",
            "in": "query",
            "description": "Set to 1 to return the complete unmodified upstream payload.",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Company profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Upstream registry error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/lookups": {
      "get": {
        "summary": "All filter code tables",
        "responses": {
          "200": {
            "description": "Code tables",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/lookups/activity": {
      "get": {
        "summary": "Search business activities (ISIC4) by name",
        "description": "Returns ISIC4 {code,name} matches from the registry's live activity search (source: 'live'); falls back to a bundled offline table with synonym aliases if the live endpoint is unreachable or has no match (source: 'offline_fallback'). Use the code with /search?activity=<code>; /search?activity=<name> also resolves automatically. Raw ISIC4 codes always work.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Activity name search text (e.g. restaurant, warehouse).",
            "schema": {
              "type": "string",
              "example": "restaurant"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Max matches (default 50).",
            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching activities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "string"
                    },
                    "query": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "flag": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/lookups/{table}": {
      "get": {
        "summary": "One filter code table",
        "parameters": [
          {
            "name": "table",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "status",
                "type",
                "nationality",
                "sector",
                "municipality"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Code table",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "flag": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unknown table",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Company": {
        "type": "object",
        "properties": {
          "cr_number": {
            "type": "string",
            "example": "21"
          },
          "branch": {
            "type": "string",
            "example": "10"
          },
          "name_en": {
            "type": "string",
            "example": "INTERMART GENERAL TRADING W.L.L"
          },
          "name_ar": {
            "type": "string"
          },
          "company_type": {
            "type": "string",
            "example": "With Limited Liability Company"
          },
          "status": {
            "type": "string",
            "example": "ACTIVE"
          },
          "registered_on": {
            "type": "string",
            "example": "05/09/2007"
          },
          "expires_on": {
            "type": "string",
            "example": "05/09/2027"
          },
          "activities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sector": {
            "type": "string"
          }
        }
      },
      "CodeName": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "flag": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
