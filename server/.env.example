# Require an x-api-key header on all endpoints (except / and /health).
# Leave unset to run the API open (fine for local / private networks).
# SIJILAT_API_KEY=choose-a-long-random-secret

# Override the upstream base (rarely needed).
# SIJILAT_BASE_URL=https://api.sijilat.bh/api/

# Port for the Node server (ignored on Vercel).
# PORT=3000
