{
  "name": "sijilat-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deployable HTTP API for querying Bahrain's Sijilat commercial registry",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcp": "tsx src/mcp.ts",
    "mcp:start": "node dist/mcp.js",
    "bundle:mcp": "node scripts/bundle-mcp.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@scalar/hono-api-reference": "^0.5.165",
    "hono": "^4.6.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
