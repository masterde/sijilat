{
  "manifest_version": "0.3",
  "name": "sijilat-pp-mcp",
  "display_name": "Sijilat",
  "version": "0.1.0",
  "description": "The first free, scriptable, agent-native CLI for Bahrain's commercial registry — with a local store, ownership-graph traversal, and change-diffing no other tool has.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/sijilat-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/sijilat-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
